# Emberhall environment
# Copy this file to .env at the project root, then fill in the keys you have.
# Every value is optional. Without keys the hall still runs with the local
# Oracle and the Crown Ledger sandbox, so you can explore before signing up
# for anything.

# AI counsel (Groq, free tier at https://console.groq.com)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# PayPal sandbox (https://developer.paypal.com/dashboard)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PLATFORM_FEE_PERCENT=10

# Authentication
# Use a long random string in production. This default is for local play only.
JWT_SECRET=emberhall-guild-secret-key-for-local-development-please-change-in-production-42

# Server
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DATA=true

# Database
# The default is a file backed H2 database. Leave these commented for local
# development, or point them at PostgreSQL and start with the postgres profile.
# DATABASE_URL=jdbc:h2:file:./data/emberhall;MODE=PostgreSQL;AUTO_SERVER=TRUE
# DATABASE_USER=sa
# DATABASE_PASSWORD=
# DATABASE_DRIVER=org.h2.Driver

# Redis presence (optional)
# Set REDIS_ENABLED=true after starting Redis to share online presence across
# server instances. With it off, presence is kept in memory.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
